<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMatchSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Showing strict 100% pantry matches only"
            android:textColor="#E8F5E9"
            android:textSize="14sp" />

        <!-- Filter Buttons (Strict Match vs Bonus Stretch "Almost There") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStrictFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:text="Strict Matches"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAlmostThereFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#1B5E20"
                android:text="Almost There (-1)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Zero-Match Feedback (Required by Section 2.2) -->
    <TextView
        android:id="@+id/tvZeroRecipesFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="No recipes match your pantry yet - add more ingredients!\n\n(Tip: Try adding Egg: 2 pcs, Butter: 10 g, and Salt: 1 tsp to unlock Classic Scrambled Eggs!)"
        android:textColor="#616161"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- RecyclerView for Suggested Recipes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp" />

    <Button
        android:id="@+id/btnBackToPantry"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="12dp"
        android:text="← Back to My Pantry" />

</LinearLayout>