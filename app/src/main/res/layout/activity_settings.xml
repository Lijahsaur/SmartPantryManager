<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pantry Settings &amp; Preferences"
        android:textColor="#1B5E20"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="Customize your Smart Pantry Manager experience."
        android:textColor="#616161"
        android:textSize="14sp" />

    <Switch
        android:id="@+id/switchExpiryAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:text="Enable Expiring-Soon Alerts"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/switchMetricUnits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:text="Use Metric Units (g / ml) by Default"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnLoadDemoPantry"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1976D2"
        android:text="Quick-Load Sample Pantry Ingredients"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#2E7D32"
        android:text="Save Settings &amp; Return"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>